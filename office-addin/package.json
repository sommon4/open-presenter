{
  "name": "open-presenter-office-addin",
  "version": "0.1.0",
  "private": true,
  "description": "PowerPoint content add-in that embeds Open Presenter (Claper) interactions into slides.",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "manifest": "node scripts/manifest.mjs",
    "certs": "office-addin-dev-certs install",
    "validate": "office-addin-manifest validate manifest.xml",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "phoenix": "^1.7.21",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.400",
    "@types/phoenix": "^1.6.7",
    "@types/qrcode": "^1.5.5",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
