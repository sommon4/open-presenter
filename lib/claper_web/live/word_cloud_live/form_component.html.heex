<div>
  <.form
    :let={f}
    for={@changeset}
    id="word-cloud-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    class="flex flex-col gap-6"
  >
    <div class="flex flex-col gap-4">
      <.text_field
        form={f}
        key={:title}
        label={gettext("Question")}
        placeholder={gettext("What comes to mind when you hear genetic testing?")}
        autocomplete="off"
        maxlength="255"
        required
        autofocus
      />

      <div class="flex gap-4">
        <div class="flex-1">
          <.text_field
            form={f}
            key={:max_answers}
            type="number"
            label={gettext("Maximum answers per attendee")}
            min="1"
            max="10"
            required
          />
        </div>
        <div class="flex-1">
          <.text_field
            form={f}
            key={:max_characters}
            type="number"
            label={gettext("Maximum characters per answer")}
            min="1"
            max="100"
            required
          />
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <p class="text-sm font-bold text-base-content">{gettext("Options")}</p>

      <.checkbox
        form={f}
        key={:show_results}
        label={gettext("Show the live word cloud to attendees on their device")}
      />
      <.checkbox
        form={f}
        key={:merge_case}
        label={gettext("Merge answers ignoring case (\"AI\" and \"ai\" count as one)")}
      />
      <.checkbox
        form={f}
        key={:moderation_enabled}
        label={gettext("Moderate answers before they appear (adds presenter workload)")}
      />
      <.checkbox
        form={f}
        key={:profanity_filter_enabled}
        label={gettext("Block common profanity")}
      />
    </div>

    <div class="flex flex-col gap-2">
      <button
        type="submit"
        phx-disable-with={gettext("Loading...")}
        class="btn btn-primary w-full"
      >
        {case @live_action do
          :new -> gettext("Add word cloud")
          :edit -> gettext("Save")
        end}
      </button>
      <%= if @live_action == :edit do %>
        <.link
          href={~p"/export/word_clouds/#{@word_cloud.id}"}
          method="post"
          class="btn btn-outline w-full"
        >
          {gettext("Export answers (CSV)")}
        </.link>
        {link(gettext("Delete"),
          to: "#",
          phx_click: "delete",
          phx_target: @myself,
          phx_value_id: @word_cloud.id,
          data: [
            confirm: gettext("This will delete the word cloud and all its answers, are you sure?")
          ],
          class: "btn btn-outline btn-error w-full"
        )}
      <% end %>
    </div>
  </.form>
</div>
