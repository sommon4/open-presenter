<div>
  <.form
    :let={f}
    for={@changeset}
    id="open-ended-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    class="flex flex-col gap-6"
  >
    <div class="flex flex-col gap-4">
      <.text_field
        form={f}
        key={:title}
        label={gettext("Question")}
        placeholder={gettext("What's the best advice you've ever been given?")}
        autocomplete="off"
        maxlength="255"
        required
        autofocus
      />

      <div class="w-64">
        <.text_field
          form={f}
          key={:max_characters}
          type="number"
          label={gettext("Maximum characters per response")}
          min="1"
          max="1000"
          required
        />
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <p class="text-sm font-bold text-base-content">{gettext("Response settings")}</p>

      <.checkbox
        form={f}
        key={:multiple_responses}
        label={gettext("Multiple responses per person")}
      />
      <.checkbox form={f} key={:auto_scroll} label={gettext("Auto-scroll to new responses")} />
      <.checkbox form={f} key={:voting_enabled} label={gettext("Vote on responses")} />
      <.checkbox
        form={f}
        key={:show_results}
        label={gettext("Show responses to attendees on their device")}
      />
      <.checkbox
        form={f}
        key={:moderation_enabled}
        label={gettext("Moderate responses before they appear")}
      />
    </div>

    <div class="flex flex-col gap-2">
      <button
        type="submit"
        phx-disable-with={gettext("Loading...")}
        class="btn btn-primary w-full"
      >
        {case @live_action do
          :new -> gettext("Add open ended question")
          :edit -> gettext("Save")
        end}
      </button>
      <%= if @live_action == :edit do %>
        <.link
          href={~p"/export/open_ended/#{@open_ended.id}"}
          method="post"
          class="btn btn-outline w-full"
        >
          {gettext("Export responses (CSV)")}
        </.link>
        {link(gettext("Delete"),
          to: "#",
          phx_click: "delete",
          phx_target: @myself,
          phx_value_id: @open_ended.id,
          data: [
            confirm: gettext("This will delete the question and all its responses, are you sure?")
          ],
          class: "btn btn-outline btn-error w-full"
        )}
      <% end %>
    </div>
  </.form>
</div>
